generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String   @id @default(uuid())
  address                String   @unique
  role                   String   @default("user")
  createdAt              DateTime @default(now()) @map("created_at")
  phoneNumber            String?  @unique @default("") @map("phone_number")
  bskyHandle             String?  @unique @map("bsky_handle")
  totalEarned            Float    @default(0) @map("total_earned")
  earnedTodayFromPosts   Float    @default(0) @map("earned_today_from_posts")
  earnedTodayFromReplies Float    @default(0) @map("earned_today_from_replies")
  earnedTodayFromLikes   Float    @default(0) @map("earned_today_from_likes")
  availableEarnings      Float    @default(0) @map("available_earnings")
  claimedEarnings        Float    @default(0) @map("claimed_earnings")

  // Relations
  userPosts   UserPost[]
  userReplies UserReply[]
  userLikes   UserLike[]

  @@map("users")
}

model UserPost {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  text      String
  bskyUri   String   @unique @map("bsky_uri")
  status    Status   @default(available)
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_posts")
}

model UserReply {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  text      String
  bskyUri   String   @unique @map("bsky_uri")
  status    Status   @default(available)
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_replies")
}

model UserLike {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  bskyUri   String   @unique @map("bsky_uri")
  status    Status   @default(available)
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_likes")
}

enum Status {
  available
  cap_hit
  claimed
}
