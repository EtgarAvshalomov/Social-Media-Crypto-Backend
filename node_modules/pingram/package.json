{
  "name": "pingram",
  "version": "1.0.5",
  "description": "Official Node.js SDK for Pingram - Send notifications via Email, SMS, Push, In-App, and more",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "pingram",
    "notificationapi",
    "notification",
    "sdk",
    "typescript",
    "email",
    "sms",
    "push",
    "in-app",
    "slack",
    "api"
  ],
  "author": "Pingram",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/notificationapi-com/serverless.git",
    "directory": "sdks/node"
  },
  "homepage": "https://www.pingram.io/docs/reference/node",
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.25.2",
    "@types/js-yaml": "^3.12.5",
    "@types/mustache": "^4.2.5",
    "@types/node": "^20.11.30",
    "js-yaml": "^3.14.2",
    "mustache": "^4.2.0",
    "openapi-types": "^12.1.0",
    "prettier": "^3.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.3"
  },
  "dependencies": {
    "node-fetch": "^2.7.0"
  },
  "overrides": {
    "minimatch": ">=10.2.3"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  }
